<resources>
    <style name="Theme.SaldoAndalucia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#176B36</item>
    </style>

    <!-- Android muestra únicamente un fondo verde durante el arranque nativo.
         La bienvenida con el logotipo completo se dibuja después en Compose. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#176B36</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.SaldoAndalucia</item>
    </style>
</resources>
